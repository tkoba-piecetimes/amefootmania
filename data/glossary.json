      "category": "得点",
      "source": "https://americanfootball.jp/beginner/"
    },
    {
      "id": "field-goal",
      "term": "フィールドゴール",
      "aliases": [
        "フィールド ゴール"
      ],
      "short": "ゴールポストの間にボールを蹴り込んで得る、3点の得点。キックが成功したときだけ入る。",
      "diagram": "amefoot-scoring",
      "category": "得点",
      "source": "https://americanfootball.jp/beginner/"
    },
    {
      "id": "try",
      "term": "トライ",
      "aliases": [
        "トライフォーポイント"
      ],
      "short": "タッチダウンのあとに行う追加のプレー。キックが成功すれば1点、走るか投げるかして成功すれば2点。",
      "diagram": "amefoot-scoring",
      "category": "得点",
      "source": "https://americanfootball.jp/wp-content/uploads/%E3%82%A2%E3%83%A1%E3%83%95%E3%83%88%E5%85%AC%E5%BC%8F%E3%83%AB%E3%83%BC%E3%83%AB%E3%83%96%E3%83%83%E3%82%AF2026-2027_%E8%BB%BD%E9%87%8F.pdf"
    },
    {
      "id": "safety",
      "term": "セーフティ",
      "aliases": [
        "セイフティ"
      ],
      "short": "守備の最後方に立つ選手。また、攻撃側が自陣エンドゾーンで止められて相手に入る2点の得点もこう呼ぶ。",
      "diagram": "amefoot-scoring",
      "category": "得点",
      "source": "https://americanfootball.jp/beginner/"
    },
    {
      "id": "touchback",
      "term": "タッチバック",
      "aliases": [],
      "short": "攻撃側の責任でボールが相手のエンドゾーンを越えて止まること。守備側の20ヤード（キック後は25ヤード）から再開。",
      "diagram": "amefoot-kickoff-lines",
      "category": "キック",
      "source": "https://americanfootball.jp/wp-content/uploads/%E3%82%A2%E3%83%A1%E3%83%95%E3%83%88%E5%85%AC%E5%BC%8F%E3%83%AB%E3%83%BC%E3%83%AB%E3%83%96%E3%83%83%E3%82%AF2026-2027_%E8%BB%BD%E9%87%8F.pdf"
    },
    {
      "id": "kickoff",
      "term": "キックオフ",
      "aliases": [
        "キック オフ"
      ],
      "short": "試合開始やタッチダウンの後などに、ボールを蹴って始めるプレー。蹴る側は自陣35ヤードから蹴る。",
      "diagram": "amefoot-kickoff-lines",
      "category": "キック",
      "source": "https://americanfootball.jp/wp-content/uploads/%E3%82%A2%E3%83%A1%E3%83%95%E3%83%88%E5%85%AC%E5%BC%8F%E3%83%AB%E3%83%BC%E3%83%AB%E3%83%96%E3%83%83%E3%82%AF2026-2027_%E8%BB%BD%E9%87%8F.pdf"
    },
    {
      "id": "punt",
      "term": "パント",
      "aliases": [],
      "short": "ボールを手から落とし、地面に着く前に蹴るキック。攻撃が進まないとき、陣地を押し返すために使う。",
      "category": "キック",
      "source": "https://americanfootball.jp/wp-content/uploads/%E3%82%A2%E3%83%A1%E3%83%95%E3%83%88%E5%85%AC%E5%BC%8F%E3%83%AB%E3%83%BC%E3%83%AB%E3%83%96%E3%83%83%E3%82%AF2026-2027_%E8%BB%BD%E9%87%8F.pdf"
    },
    {
      "id": "fair-catch",
      "term": "フェアキャッチ",
      "aliases": [
        "フェア キャッチ"
      ],
      "short": "蹴られたボールを受ける選手が合図を出してキャッチすること。その場で止まり、相手から当たられない。",
      "category": "キック",
      "source": "https://americanfootball.jp/wp-content/uploads/%E3%82%A2%E3%83%A1%E3%83%95%E3%83%88%E5%85%AC%E5%BC%8F%E3%83%AB%E3%83%BC%E3%83%AB%E3%83%96%E3%83%83%E3%82%AF2026-2027_%E8%BB%BD%E9%87%8F.pdf"
    },
    {
      "id": "special-team",
      "term": "スペシャルチーム",
      "aliases": [],
      "short": "キックオフ・パント・フィールドゴールなど、ボールを蹴る場面で出場するチーム。",
      "category": "キック",
      "source": "https://spaia.jp/column/american_football/1883"
    },
    {
      "id": "fumble",
      "term": "ファンブル",
      "aliases": [],
      "short": "ボールを持つ選手が、落としたりはじかれたりして、ボールを持ち続けられなくなること。",
