      "source": "https://americanfootball.jp/wp-content/uploads/%E3%82%A2%E3%83%A1%E3%83%95%E3%83%88%E5%85%AC%E5%BC%8F%E3%83%AB%E3%83%BC%E3%83%AB%E3%83%96%E3%83%83%E3%82%AF2026-2027_%E8%BB%BD%E9%87%8F.pdf"
    },
    {
      "id": "interception",
      "term": "インターセプト",
      "aliases": [],
      "short": "相手の投げたパスを空中で奪い取ること。奪った側が攻撃権を得る。",
      "category": "ボールの動き",
      "source": "https://americanfootball.jp/wp-content/uploads/%E3%82%A2%E3%83%A1%E3%83%95%E3%83%88%E5%85%AC%E5%BC%8F%E3%83%AB%E3%83%BC%E3%83%AB%E3%83%96%E3%83%83%E3%82%AF2026-2027_%E8%BB%BD%E9%87%8F.pdf"
    },
    {
      "id": "offense",
      "term": "オフェンス",
      "aliases": [],
      "short": "ボールを確保していて、相手のゴールを目指して攻めている側のチーム。",
      "category": "ポジション",
      "source": "https://americanfootball.jp/beginner/"
    },
    {
      "id": "defense",
      "term": "ディフェンス",
      "aliases": [],
      "short": "ボールを持たず、相手の攻撃を止める側のチーム。相手に進ませず、ボールを奪うことも目指す。",
      "category": "ポジション",
      "source": "https://americanfootball.jp/beginner/"
    },
    {
      "id": "qb",
      "term": "QB",
      "aliases": [
        "クォーターバック"
      ],
      "short": "攻撃の司令塔。作戦に合わせて、パスを投げたり、走る選手にボールを渡したりする。",
