      "source": "https://americanfootball.jp/wp-content/uploads/%E3%82%A2%E3%83%A1%E3%83%95%E3%83%88%E5%85%AC%E5%BC%8F%E3%83%AB%E3%83%BC%E3%83%AB%E3%83%96%E3%83%83%E3%82%AF2026-2027_%E8%BB%BD%E9%87%8F.pdf"
    },
    {
      "id": "penalty-yards",
      "term": "罰退",
      "aliases": [
        "罰退ヤード"
      ],
      "short": "反則の罰として、そのチームの陣地が後ろへ下げられること。5・10・15ヤードなど反則ごとに決まっている。",
      "category": "反則",
      "source": "https://americanfootball.jp/wp-content/uploads/%E3%82%A2%E3%83%A1%E3%83%95%E3%83%88%E5%85%AC%E5%BC%8F%E3%83%AB%E3%83%BC%E3%83%AB%E3%83%96%E3%83%83%E3%82%AF2026-2027_%E8%BB%BD%E9%87%8F.pdf"
    },
    {
      "id": "offside",
      "term": "オフサイド",
      "aliases": [],
      "short": "守備側の選手が、プレー開始の瞬間に、ボールの位置の線を越えて入っている反則。",
      "diagram": "amefoot-scrimmage-neutral-zone",
      "category": "反則",
      "source": "https://americanfootball.jp/wp-content/uploads/%E3%82%A2%E3%83%A1%E3%83%95%E3%83%88%E5%85%AC%E5%BC%8F%E3%83%AB%E3%83%BC%E3%83%AB%E3%83%96%E3%83%83%E3%82%AF2026-2027_%E8%BB%BD%E9%87%8F.pdf"
    },
    {
      "id": "targeting",
      "term": "ターゲティング",
      "aliases": [],
      "short": "ヘルメットの頭頂部や、無防備な相手の首・頭を狙って強く当たる、危険な反則。",
      "category": "反則",
      "source": "https://americanfootball.jp/wp-content/uploads/%E3%82%A2%E3%83%A1%E3%83%95%E3%83%88%E5%85%AC%E5%BC%8F%E3%83%AB%E3%83%BC%E3%83%AB%E3%83%96%E3%83%83%E3%82%AF2026-2027_%E8%BB%BD%E9%87%8F.pdf"
    },
    {
      "id": "touchdown",
      "term": "タッチダウン",
      "aliases": [
        "タッチ ダウン"
      ],
      "short": "ボールを持って相手のエンドゾーンに入る、またはその中でパスをキャッチして得る6点の得点。",
